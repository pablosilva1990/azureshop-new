# Stack self-contained para publicar a mesma aplicacao AzureShop em um AKS,
# rodando EM PARALELO ao stack App Service (infra/terraform/appservice).
# Reaproveita ACR e Key Vault ja criados por aquele stack (via data source),
# mas cria um Azure SQL DEDICADO ao AKS (o servidor do App Service foi excluido).
# Copie para terraform.tfvars local para uso manual; a pipeline injeta via
# TF_VAR_* e nao precisa deste arquivo. NUNCA versione terraform.tfvars, planos ou state.

suffix   = "aks01"
location = "westus3"

aks_node_count = 1
aks_node_size  = "Standard_D4s_v5"

# Recursos existentes do stack App Service, reaproveitados via data source.
shared_resource_group_name = "rg-azureshop-shop01"
acr_name                   = "acrazureshopshop01"
key_vault_name             = "kv-azshop2-shop01"

# Azure SQL dedicado ao AKS (criado por este stack).
sql_server_name    = "" # vazio = sql-azureshop-<suffix>
sql_database_name  = "azureshop"
sql_sku_name       = "GP_S_Gen5_1"
sql_admin_login    = "azureshopadmin"
allow_azure_services  = false
sql_public_network_access = false
