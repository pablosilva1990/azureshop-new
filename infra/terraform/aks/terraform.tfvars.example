# Stack self-contained para publicar a mesma aplicacao AzureShop em um AKS,
# rodando EM PARALELO ao stack App Service (infra/terraform/appservice).
# Reaproveita ACR, Azure SQL e Key Vault ja criados por aquele stack (via data
# source) e cria apenas os recursos novos do AKS. Copie para terraform.tfvars
# local para uso manual; a pipeline injeta via TF_VAR_* e nao precisa deste arquivo.
# NUNCA versione terraform.tfvars, planos ou state.

suffix   = "aks01"
location = "westus3"

aks_node_count = 1
aks_node_size  = "Standard_D2s_v5"

# Recursos existentes do stack App Service, reaproveitados via data source.
shared_resource_group_name = "rg-azureshop-shop01"
acr_name                   = "acrazureshopshop01"
sql_server_name            = "sql-azureshop-shop01"
sql_database_name          = "azureshop"
sql_admin_login            = "azureshopadmin"
key_vault_name             = "kv-azshop2-shop01"
